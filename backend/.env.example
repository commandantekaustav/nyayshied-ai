# ==============================================================================
# NyayShield AI - Backend Configuration (.env.example)
# Google Startup Buildathon India 2026
# ==============================================================================

# Google Cloud Vertex AI Configuration
# Serverless pay-per-token Vertex AI mode ($5 credit-safe rule)
USE_VERTEXAI=true
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_API_KEY=

# Fernet Key for AES-128-CBC + HMAC PII Data Encryption (32-byte URL-safe base64)
# If left empty, NyayShield AI auto-generates and persists one on startup.
FERNET_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Model identifiers for Vertex AI / Gemini serverless pay-per-token calls
VERTEX_MODEL_ID=gemini-3.8-flash
CRITIC_MODEL_ID=gemini-3.5-flash-lite

# Telemetry metrics path
METRICS_LOG_PATH=metrics.jsonl
